# SQLite (local dev)
DATABASE_URL="file:./dev.db"

# Resend — get your key at resend.com
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"

# Where intake form submissions get emailed
TO_EMAIL="you@yourdomain.com"

# --- VERCEL PRODUCTION ---
# 1. Change schema.prisma datasource provider to "postgresql"
# 2. Set DATABASE_URL to your Neon/Supabase connection string
# 3. Run: npx prisma migrate deploy
